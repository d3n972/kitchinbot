# Copy to .env and fill in the Discord / ntfy values before running.

# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application ID (General Information tab)
DISCORD_APP_ID=
# Dev guild ID. Commands register there instantly; leave empty to register
# globally (propagation can take up to an hour).
DISCORD_GUILD_ID=
# Your Discord user ID (Developer Mode → right-click yourself → Copy User ID)
ADMIN_DISCORD_ID=

# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Start it with: bun run db:up
DATABASE_URL=postgres://kitchen:kitchen@localhost:5432/kitchenbot

# ── ntfy.sh ──────────────────────────────────────────────────────────────────
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Only needed for protected topics.
NTFY_TOKEN=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Probe endpoint (Kubernetes). Defaults to 8080.
# HEALTH_PORT=8080
